{
 "about": "Scenario table of the live TV preview (PORT-SPEC 4.1), read by preview_live.py and stub_preview.py. Copyright (C) 2026 XENO STORE contributors. SPDX-License-Identifier: GPL-3.0-or-later. Each group is one test world (one backend, one seeding, one run of the preview binary with XENO_SCENARIOS = its scenarios, in order). Capture and mark names are those of app/tv/host/preview_main.cpp; when the binary answers --list, preview_live.py takes them from it and reports any difference from this table (report.json scenarioList.drift), so keep them in step.",
 "version": 1,
 "today": "2026-10-15",
 "sweep": ["discover", "game", "downloads", "library-details", "settings-*"],
 "worldDefaults": {"backend": "up", "loader": "none", "saved": null, "acknowledged": true, "library": true, "tvApp": "none", "updates": true, "concurrentDownloads": 2, "seed": ["pair", "acknowledge"]},
 "groups": [
  {"name": "offline", "world": {"backend": "down", "loader": "none", "seed": []}, "scenarios": ["offline"]},
  {"name": "no-loader", "world": {"backend": "down", "loader": "closed", "seed": []}, "scenarios": ["no-loader"]},
  {"name": "cold-start", "world": {"backend": "down", "loader": "fake", "seed": []}, "scenarios": ["cold-start"]},
  {"name": "crash-fallback", "world": {"backend": "down", "loader": "fake", "saved": "crash", "seed": []}, "scenarios": ["crash-fallback"]},
  {"name": "setup", "world": {"acknowledged": false, "seed": ["pair"]}, "scenarios": ["setup"]},
  {"name": "downloads", "world": {"seed": ["pair", "acknowledge", "settings", "downloads"]}, "scenarios": ["downloads", "downloads-finished", "downloads-dialog", "delete-cancelled", "downloads-actions", "queued", "download", "game", "game-viking", "game-ps4", "game-library"]},
  {"name": "store", "world": {"seed": ["pair", "acknowledge", "finished-download"]}, "scenarios": ["discover", "browse", "browse-platform", "browse-filters", "library-details", "library-storage", "settings", "settings-sources", "settings-pairing", "settings-catalogue", "settings-more", "settings-storage", "settings-downloads", "settings-updates", "settings-tv-app", "library"]},
  {"name": "library-copy", "world": {"seed": ["pair", "acknowledge"]}, "scenarios": ["library-copy"]},
  {"name": "tv-app-orbit", "variant": "orbit", "world": {"tvApp": "orbit"}, "scenarios": ["settings-tv-app"], "sweep": false},
  {"name": "tv-app-manual", "variant": "manual", "world": {"tvApp": "manual"}, "scenarios": ["settings-tv-app"], "sweep": false},
  {"name": "restart", "world": {"loader": "fake", "seed": ["pair", "acknowledge", "downloads-light"]}, "scenarios": ["restart"]},
  {"name": "connection-lost", "world": {}, "scenarios": ["connection-lost"]},
  {"name": "state-unhealthy", "world": {"seed": ["pair", "acknowledge", "block-queue"]}, "scenarios": ["state-unhealthy"]}
 ],
 "scenarios": {
  "offline": {"captures": ["offline-opening", "offline-screen"], "expect": {"linkError": true}},
  "no-loader": {"captures": ["no-loader"], "expect": {"linkError": true, "loaderSends": 0}},
  "cold-start": {"captures": ["cold-start-opening", "cold-start-starting", "cold-start-discover"], "expect": {"loaderSends": 1, "starterOrder": ["copy=bundled"]}},
  "crash-fallback": {"captures": ["crash-fallback-failed", "crash-fallback-recovered"], "maxSeconds": 120, "expect": {"loaderSends": 2, "starterOrder": ["copy=saved", "copy=bundled"]}},
  "setup": {"captures": ["setup", "setup-sources", "setup-ready", "setup-done"]},
  "discover": {"captures": ["discover", "discover-rail", "discover-added", "discover-all", "top-bar", "discover-favourite"], "expect": {"art": true}},
  "browse": {"captures": ["browse", "browse-keyboard", "browse-filters", "browse-results"]},
  "browse-platform": {"captures": ["browse-platform-menu", "browse-ps4", "browse-ps4-details"]},
  "browse-filters": {"captures": ["browse-region-menu", "browse-region", "browse-format-menu", "browse-favourites"]},
  "game": {"captures": ["game", "game-options", "game-source", "game-drive-menu", "game-delivery", "game-about", "game-download-ready", "game-download-added"]},
  "game-viking": {"captures": ["game-viking", "game-viking-notice", "game-viking-open"]},
  "game-ps4": {"captures": ["game-ps4", "game-ps4-options"]},
  "game-library": {"captures": ["game-library"]},
  "downloads": {"captures": ["downloads", "downloads-row", "downloads-dialog", "downloads-failed", "downloads-cancelled", "downloads-complete"]},
  "downloads-finished": {"captures": ["downloads-finished"]},
  "downloads-dialog": {"captures": ["downloads-dialog-cancel"]},
  "delete-cancelled": {"captures": ["cancelled-download", "delete-cancelled", "forget-cancelled"]},
  "downloads-actions": {"captures": ["downloads-actions-active", "downloads-actions-paused", "downloads-actions-resumed", "downloads-actions-cancelled", "downloads-actions-delete", "downloads-actions-deleted"]},
  "queued": {"captures": ["game-queued"]},
  "download": {"captures": ["download-ready", "download-added"]},
  "library": {"captures": ["library", "library-grid", "library-details", "library-copy", "library-storage", "library-installed", "library-unavailable"], "expect": {"marks": ["remove-drive"]}},
  "library-details": {"captures": ["library-details-panel", "library-details-copy"]},
  "library-copy": {"captures": ["library-copy-confirm", "library-copy-destinations", "library-copy-ready", "library-copy-progress", "library-copy-done"], "maxSeconds": 90},
  "library-storage": {"captures": ["library-storage-drives", "library-storage-drive"]},
  "settings": {"captures": ["settings", "settings-storage", "settings-storage-saved", "settings-pairing", "settings-catalogue", "settings-catalogue-refreshed", "settings-updates-current", "settings-more"]},
  "settings-sources": {"captures": ["settings-sources-list"]},
  "settings-storage": {"captures": ["settings-storage-drives", "settings-storage-auto"]},
  "settings-downloads": {"captures": ["settings-downloads-limit", "settings-downloads-max", "settings-downloads-archives"]},
  "settings-pairing": {"captures": ["settings-pairing-code"]},
  "settings-catalogue": {"captures": ["settings-catalogue-status", "settings-catalogue-busy", "settings-catalogue-done"]},
  "settings-updates": {"captures": ["settings-updates-status", "settings-updates-checked", "settings-updates-saved"]},
  "settings-tv-app": {"captures": ["settings-tv-app", "settings-tv-app-checked"]},
  "settings-more": {"captures": ["settings-more-page"]},
  "restart": {"captures": ["restart-confirm", "restart-stopping", "restart-done"], "maxSeconds": 90, "expect": {"loaderSends": 1, "allow503": true, "drain": true}},
  "connection-lost": {"captures": ["connection-lost-before", "connection-lost-banner"], "expect": {"linkError": true, "marks": ["stop-backend"]}},
  "state-unhealthy": {"captures": ["state-unhealthy-banner"]}
 }
}
